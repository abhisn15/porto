# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# GIF Hero lama (5,6 MB + 2,4 MB) sudah diganti WebP beranimasi.
# awan.gif masih terkunci proses lain saat dihapus; pola ini menjaganya
# tidak ikut ter-commit kalau berkasnya masih ada di disk.
public/assets/hero/*.gif
